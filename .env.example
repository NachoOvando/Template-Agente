# Copiar a .env y completar — nunca commitear el .env real.

# Google Gemini (usado exclusivamente por llm/gemini_provider.py)
GOOGLE_API_KEY=

# Postgres + pgvector
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# API key interna para proteger POST /knowledge-chunks (ingesta)
INTERNAL_API_KEY=

# Orígenes permitidos para CORS, separados por coma. Incluir acá cada
# dominio que aloje apps/web (página de prueba) o el widget embebido
# (apps/web/dist-widget/widget.js). Nunca "*" fuera de desarrollo local.
CORS_ALLOWED_ORIGINS=http://localhost:5173
